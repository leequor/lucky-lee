# Public Supabase project settings. These are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by scripts/seed-demo-users.mjs. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL used in Supabase email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password for the seeded demo accounts. Do not commit a real value.
DEMO_PASSWORD=change-me-demo-only

# Set to true only when taking local design screenshots.
NEXT_PUBLIC_DESIGN_PREVIEW=false
